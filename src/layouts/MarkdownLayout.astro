---
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";

interface Props {
    title: string;
    description?: string;
    published?: Date;
    updated?: Date;
    heroImage?: string;
    headings?: MarkdownHeading[];
}

const { title, description, published, updated, heroImage, headings = [] } = Astro.props;
const hasToc = headings.length > 0;

const formatDate = (date?: Date): string | null => {
    if (!date) {
        return null;
    }

    return new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
    }).format(date);
};

const publishedText = formatDate(published);
const updatedText = formatDate(updated);
---

<Layout title={`${title} | Justin High`}>
    <article
        class="markdown-article glass-card-primary p-8 sm:p-10 lg:p-12"
        data-has-toc={hasToc}
    >
        <header class="markdown-article__header">
            <p class="markdown-article__eyebrow">Markdown Page</p>
            <h1 class="markdown-article__title">{title}</h1>
            {
                description && (
                    <p class="markdown-article__description">
                        {description}
                    </p>
                )
            }
            {(publishedText || updatedText) && (
                <dl class="markdown-article__meta">
                    {
                        publishedText && (
                            <>
                                <dt class="markdown-article__meta-label">Published</dt>
                                <dd class="markdown-article__meta-value">{publishedText}</dd>
                            </>
                        )
                    }
                    {
                        updatedText && (
                            <>
                                <dt class="markdown-article__meta-label">Updated</dt>
                                <dd class="markdown-article__meta-value">{updatedText}</dd>
                            </>
                        )
                    }
                </dl>
            )}
            {
                heroImage && (
                    <figure class="markdown-article__hero">
                        <img src={heroImage} alt={title} loading="lazy" />
                    </figure>
                )
            }
        </header>

        <div class="markdown-article__body">
            <div class="markdown-article__content">
                <slot />
            </div>

            {
                hasToc && (
                    <aside class="markdown-article__toc">
                        <h2 class="markdown-article__toc-title">On this page</h2>
                        <ul class="markdown-article__toc-list">
                            {
                                headings.map((heading) => (
                                    <li
                                        class={`markdown-article__toc-item level-${heading.depth}`}
                                    >
                                        <a href={`#${heading.slug}`}>
                                            {heading.text}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </aside>
                )
            }
        </div>
    </article>
</Layout>
