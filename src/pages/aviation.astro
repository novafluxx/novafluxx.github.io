---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Justin High - Aviation">
	<div
		class="hero-section hero-section--aviation"
		style="background: linear-gradient(rgba(15, 23, 42, 0.5), rgba(15, 23, 42, 0.6)), url('/images/flight-line.jpg'); background-size: cover; background-position: center;"
	>
		<div class="hero-content text-center">
			<h1>Aviation Journey</h1>
			<h2 class="hero-subtitle">Licensed Private Pilot</h2>
		</div>
	</div>

	<div class="aviation-content">
		<div class="section">
			<h2>My Flying Experience</h2>
			<div class="experience-card glass-card p-8 flex items-center gap-6">
				<div class="card-icon text-4xl text-blue-500">
					<i class="fas fa-plane"></i>
				</div>
				<div class="card-content">
					<h3>Private Pilot License</h3>
					<p>
						Achieved the dream of becoming a licensed private pilot,
						opening up new horizons and perspectives.
					</p>
				</div>
			</div>
		</div>

		<div class="section">
			<h2>Aviation Skills</h2>
			<div class="skills-grid grid grid-cols-1 md:grid-cols-3 gap-6">
				<div class="skill-card glass-card p-6 text-center">
					<i class="fas fa-compass text-3xl mb-4 text-blue-400"></i>
					<h3>Navigation</h3>
					<p>Proficient in VFR navigation and flight planning</p>
				</div>
				<div class="skill-card glass-card p-6 text-center">
					<i class="fas fa-cloud text-3xl mb-4 text-gray-400"></i>
					<h3>Weather</h3>
					<p>Experienced in weather analysis and decision making</p>
				</div>
				<div class="skill-card glass-card p-6 text-center">
					<i class="fas fa-tower-broadcast text-3xl mb-4 text-red-400"
					></i>
					<h3>Communications</h3>
					<p>Fluent in aviation radio communications</p>
				</div>
			</div>
		</div>
	</div>
</Layout>
