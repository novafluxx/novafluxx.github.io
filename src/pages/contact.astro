---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Justin High - Contact">
	<div class="hero-section">
		<div class="hero-content text-center">
			<h1>Get in Touch</h1>
			<h2 class="hero-subtitle">
				I'm always interested in discussing new opportunities, sharing
				aviation experiences, or talking about quality assurance and
				automation.
			</h2>
		</div>
	</div>

	<div class="contact-section">
		<div
			class="contact-grid grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto"
		>
			<div class="contact-card glass-card p-8 text-center">
				<i class="fab fa-linkedin text-5xl mb-4 text-blue-600" aria-hidden="true"></i>
				<h3>LinkedIn</h3>
				<p class="mb-6">Connect with me professionally on LinkedIn</p>
				<a
					href="https://www.linkedin.com/in/justin-high-4977598b"
					target="_blank"
					rel="noopener noreferrer"
					class="contact-link inline-block bg-blue-600 text-white px-6 py-2 rounded-full hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all"
					aria-label="Visit Justin's LinkedIn profile"
					>LinkedIn Profile</a
				>
			</div>

			<div class="contact-card glass-card p-8 text-center">
				<i
					class="fab fa-github text-5xl mb-4 text-slate-800 dark:text-white"
					aria-hidden="true"
				></i>
				<h3>GitHub</h3>
				<p class="mb-6">
					Check out my automation projects and contributions
				</p>
				<a
					href="https://github.com/novafluxx"
					target="_blank"
					rel="noopener noreferrer"
					class="contact-link inline-block bg-slate-800 text-white px-6 py-2 rounded-full hover:bg-slate-900 focus:ring-2 focus:ring-slate-700 focus:ring-offset-2 transition-all dark:bg-slate-700 dark:hover:bg-slate-600"
					aria-label="Visit Justin's GitHub profile"
					>GitHub Profile</a
				>
			</div>
		</div>
	</div>
</Layout>
