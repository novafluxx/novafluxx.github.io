---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Justin High - Experience">
	<div class="hero-section">
		<div class="hero-content text-center">
			<h1>Professional Experience</h1>
			<h2 class="hero-subtitle">Building Quality Through Automation</h2>
		</div>
	</div>

	<div class="experience-section">
		<div class="experience-timeline max-w-4xl mx-auto">
			<div class="timeline-item">
				<div class="timeline-content glass-card p-8">
					<h3>Quality Assurance Analyst & Automation Engineer</h3>
					<p class="timeline-period">Current Role</p>
					<ul class="responsibility-list">
						<li>
							Design and implement comprehensive test strategies
							for complex software applications
						</li>
						<li>
							Develop and maintain automated test frameworks using
							industry-standard tools
						</li>
						<li>
							Lead test automation initiatives and continuous
							integration practices
						</li>
						<li>
							Collaborate with development teams to ensure
							software quality throughout the SDLC
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<div class="skills-section">
		<h2>Technical Skills</h2>
		<div class="skills-grid grid grid-cols-1 md:grid-cols-3 gap-6">
			<div class="skill-category glass-card p-6">
				<h3>Testing</h3>
				<ul class="skill-list">
					<li>Test Automation</li>
					<li>Manual Testing</li>
					<li>Performance Testing</li>
					<li>API Testing</li>
				</ul>
			</div>
			<div class="skill-category glass-card p-6">
				<h3>Tools & Frameworks</h3>
				<ul class="skill-list">
					<li>Taiko</li>
					<li>Gauge</li>
					<li>Azure DevOps</li>
					<li>Jira</li>
					<li>Git</li>
				</ul>
			</div>
			<div class="skill-category glass-card p-6">
				<h3>Programming</h3>
				<ul class="skill-list">
					<li>JavaScript</li>
					<li>Python</li>
					<li>C# with .NET</li>
					<li>SQL</li>
				</ul>
			</div>
		</div>
	</div>
</Layout>
