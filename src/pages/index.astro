---
import Layout from "../layouts/Layout.astro";
import { getImage } from "astro:assets";
import flightLineImg from "../images/flight-line.jpg";

const aviationBg = await getImage({
	src: flightLineImg,
	format: "webp",
	quality: 88,
	width: 2048,
	height: 1536,
});

const heroName = "Justin High";

const toolGroups = [
	{
		label: "Test systems",
		tools: ["UI automation", "API testing", "Performance", "Manual testing"],
	},
	{
		label: "Engineering",
		tools: ["JavaScript", "Python", "C# / .NET", "Rust", "SQL"],
	},
	{
		label: "Delivery",
		tools: ["Azure DevOps", "GitHub Actions", "Jira", "Git", "CI/CD"],
	},
];
---

<Layout title="Justin High | Quality Engineer & Automation Builder">
	<canvas id="constellation-canvas" class="constellation-canvas" aria-hidden="true"></canvas>
	<section id="hero" class="hero-section" aria-labelledby="hero-title">
		<div class="hero-content">
			<div class="hero-layer hero-kicker" style="--depth: 45px;">
				<span class="status-dot" aria-hidden="true"></span>
				Quality systems online
				<span class="kicker-divider" aria-hidden="true"></span>
				Private pilot
			</div>

			<h1
				id="hero-title"
				class="hero-name hero-layer"
				style="--depth: 70px;"
				aria-label={heroName}
				data-text={heroName}
				data-mobile-text={heroName.replace(" ", "\n")}
			>
				<span class="hero-letters" aria-hidden="true">
					{heroName.split(" ").map((word, wordIndex) => {
						const letterOffset = wordIndex === 0 ? 0 : heroName.indexOf(word);

						return (
							<span class="hero-word">
								{word.split("").map((ch, letterIndex) => (
									<span class="hero-letter" style={`--i: ${letterOffset + letterIndex}`}>{ch}</span>
								))}
							</span>
						);
					})}
				</span>
			</h1>

			<p class="hero-subtitle hero-layer" style="--depth: 38px;">
				I engineer confidence into software.
			</p>
			<p class="hero-intro hero-layer" style="--depth: 28px;">
				Quality assurance, automation, and resilient product engineering, built with the precision of a preflight check.
			</p>

			<div class="hero-actions hero-layer" style="--depth: 22px;">
				<a href="#work" class="button button-primary">
					Explore selected work
					<i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
				</a>
				<a
					href="https://github.com/novafluxx"
					class="button button-quiet"
					target="_blank"
					rel="noopener noreferrer"
				>
					<i class="fa-brands fa-github" aria-hidden="true"></i>
					GitHub
				</a>
			</div>
		</div>

		<a href="#work" class="hero-scroll" aria-label="Scroll to selected work">
			<span>Scroll to inspect</span>
			<span class="scroll-track"><span></span></span>
		</a>
	</section>

	<section id="work" class="site-section work-section" aria-labelledby="work-title">
		<div class="section-shell">
			<header class="section-heading animate-on-scroll">
				<div>
					<p class="section-index"><span>01</span> Selected work</p>
					<h2 id="work-title">Built to survive the edge cases.</h2>
				</div>
				<p class="section-lede">
					I like products where quality is structural, not a final checkbox. These projects combine thoughtful interfaces with dependable systems underneath.
				</p>
			</header>

			<div class="project-grid">
				<article class="project-card project-card-dotnet animate-on-scroll">
					<div class="project-meta">
						<span class="project-number">01 / 03</span>
						<span class="live-chip"><span></span> Public project</span>
					</div>
					<div class="dotnet-visual" aria-label="FileCrypter2 desktop application illustration">
						<div class="desktop-window">
							<div class="desktop-titlebar">
								<span class="desktop-title"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> FileCrypter</span>
								<span class="desktop-controls" aria-hidden="true"><i></i><i></i><i></i></span>
							</div>
							<div class="desktop-app">
								<div class="desktop-sidebar" aria-hidden="true">
									<span class="active"><i class="fa-solid fa-lock"></i></span>
									<span><i class="fa-solid fa-lock-open"></i></span>
									<span><i class="fa-solid fa-layer-group"></i></span>
									<span><i class="fa-solid fa-gear"></i></span>
								</div>
								<div class="desktop-workspace">
									<div class="desktop-eyebrow">Encrypt a file</div>
									<div class="desktop-heading">Protect it locally.</div>
									<div class="desktop-dropzone">
										<i class="fa-regular fa-file" aria-hidden="true"></i>
										<span>Drop a file to begin</span>
									</div>
									<div class="desktop-options" aria-hidden="true">
										<span><i></i> AES-256-GCM</span>
										<span><i></i> Argon2id</span>
										<span><i></i> Local only</span>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="project-copy">
						<p class="project-type">Local-first encryption suite</p>
						<h3>FileCrypter2</h3>
						<p class="project-description">
							A .NET 10 rebuild with one tested cryptography core powering both a command-line host and an Avalonia desktop app. It handles single files, batches, and encrypted archives with authenticated encryption, optional compression, and safely staged writes.
						</p>
						<ul class="project-tags" aria-label="FileCrypter2 technologies">
							<li>C# / .NET 10</li>
							<li>Avalonia 12</li>
							<li>AES-256-GCM</li>
							<li>Argon2id</li>
						</ul>
						<a
							href="https://github.com/novafluxx/FileCrypter2"
							class="text-link"
							target="_blank"
							rel="noopener noreferrer"
						>
							View repository <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
						</a>
					</div>
				</article>

				<article class="project-card project-card-featured animate-on-scroll">
					<div class="project-meta">
						<span class="project-number">02 / 03</span>
						<span class="live-chip"><span></span> Public project</span>
					</div>
					<div class="project-copy">
						<p class="project-type">Cross-platform security utility</p>
						<h3>FileCrypter</h3>
						<p class="project-description">
							A desktop encryption app with a Vue interface and a Rust/Tauri core. Files move through authenticated encryption, memory-hard key derivation, optional compression, and crash-safe streaming writes.
						</p>
						<ul class="project-tags" aria-label="FileCrypter technologies">
							<li>Rust</li>
							<li>Tauri 2</li>
							<li>Vue 3</li>
							<li>AES-256-GCM</li>
						</ul>
						<a
							href="https://github.com/novafluxx/filecrypter"
							class="text-link"
							target="_blank"
							rel="noopener noreferrer"
						>
							View repository <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
						</a>
					</div>

					<div class="crypto-console" aria-label="FileCrypter encryption flow illustration">
						<div class="console-bar">
							<span>encryption.pipeline</span>
							<span class="console-lights" aria-hidden="true"><i></i><i></i><i></i></span>
						</div>
						<div class="console-body">
							<div class="file-node source-node">
								<i class="fa-regular fa-file" aria-hidden="true"></i>
								<span>source.data</span>
							</div>
							<div class="flow-line"><span></span></div>
							<div class="cipher-core">
								<span class="core-ring ring-one"></span>
								<span class="core-ring ring-two"></span>
								<i class="fa-solid fa-fingerprint" aria-hidden="true"></i>
							</div>
							<div class="flow-line"><span></span></div>
							<div class="file-node output-node">
								<i class="fa-solid fa-lock" aria-hidden="true"></i>
								<span>secured.enc</span>
							</div>
						</div>
						<div class="console-status">
							<span><i></i> AES-256-GCM</span>
							<span><i></i> Argon2id</span>
							<span><i></i> Atomic writes</span>
						</div>
					</div>
				</article>

				<article class="project-card project-card-notes animate-on-scroll">
					<div class="project-meta">
						<span class="project-number">03 / 03</span>
						<span class="live-chip"><span></span> Public project</span>
					</div>
					<div class="notes-visual" aria-hidden="true">
						<div class="note-sheet note-sheet-back"></div>
						<div class="note-sheet note-sheet-middle"></div>
						<div class="note-sheet note-sheet-front">
							<span class="note-dot"></span>
							<span class="note-line note-line-title"></span>
							<span class="note-line"></span>
							<span class="note-line note-line-short"></span>
							<span class="sync-pill"><i class="fa-solid fa-arrows-rotate"></i> synced</span>
						</div>
					</div>
					<p class="project-type">Offline-first progressive web app</p>
					<h3>High Notes</h3>
					<p class="project-description">
						A fast note-taking PWA with rich-text editing, local caching, queued offline mutations, secure cloud sync, and realtime updates across devices.
					</p>
					<ul class="project-tags" aria-label="High Notes technologies">
						<li>Nuxt 4</li>
						<li>TypeScript</li>
						<li>Supabase</li>
						<li>IndexedDB</li>
					</ul>
					<a
						href="https://github.com/novafluxx/HighNotes"
						class="text-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						View repository <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
					</a>
				</article>
			</div>

			<div class="proof-strip animate-on-scroll" aria-label="Engineering principles">
				<div><span>01</span><strong>Security-minded</strong><small>Threats considered early</small></div>
				<div><span>02</span><strong>Cross-platform</strong><small>Desktop and web systems</small></div>
				<div><span>03</span><strong>Offline-ready</strong><small>Resilient when networks fail</small></div>
				<div><span>04</span><strong>Pipeline-tested</strong><small>Automation in the delivery loop</small></div>
			</div>
		</div>
	</section>

	<section id="experience" class="site-section experience-section" aria-labelledby="experience-title">
		<div class="section-shell">
			<header class="section-heading section-heading-compact animate-on-scroll">
				<div>
					<p class="section-index"><span>02</span> Quality practice</p>
					<h2 id="experience-title">Turn risk into signal.</h2>
				</div>
			</header>

			<div class="experience-layout">
				<div class="experience-narrative animate-on-scroll">
					<p class="experience-role">Quality Assurance Analyst & Automation Engineer</p>
					<h3>Quality should make teams move faster, not make them afraid to ship.</h3>
					<p>
						My work connects exploratory testing, maintainable automation, and continuous delivery. The goal is a clear picture of product risk that developers can act on while the context is still fresh.
					</p>
					<div class="practice-flow" aria-label="Quality engineering workflow">
						<div><span>01</span><strong>Observe</strong><small>Map behavior and risk</small></div>
						<div><span>02</span><strong>Automate</strong><small>Protect critical paths</small></div>
						<div><span>03</span><strong>Integrate</strong><small>Move checks into CI</small></div>
						<div><span>04</span><strong>Improve</strong><small>Learn from every run</small></div>
					</div>
				</div>

				<div class="quality-console animate-on-scroll" aria-label="Quality system status">
					<div class="quality-console-header">
						<div>
							<span class="status-dot" aria-hidden="true"></span>
							Quality signal
						</div>
						<span>LIVE</span>
					</div>
					<div class="signal-orbit" aria-hidden="true">
						<span class="orbit orbit-a"></span>
						<span class="orbit orbit-b"></span>
						<span class="orbit orbit-c"></span>
						<div class="signal-center"><i class="fa-solid fa-wave-square"></i></div>
						<span class="signal-node node-ui">UI</span>
						<span class="signal-node node-api">API</span>
						<span class="signal-node node-perf">PERF</span>
						<span class="signal-node node-ci">CI</span>
					</div>
					<div class="signal-list">
						<div><span><i></i> Critical paths</span><strong>MONITORED</strong></div>
						<div><span><i></i> Feedback loops</span><strong>CONNECTED</strong></div>
						<div><span><i></i> Release confidence</span><strong>VISIBLE</strong></div>
					</div>
				</div>
			</div>

			<div class="toolkit animate-on-scroll">
				<div class="toolkit-intro">
					<p class="section-index"><span>STACK</span> Working toolkit</p>
					<p>Practical tools chosen for the system in front of me, not for the résumé keyword count.</p>
				</div>
				<div class="tool-groups">
					{toolGroups.map((group) => (
						<div class="tool-group">
							<h3>{group.label}</h3>
							<ul>
								{group.tools.map((tool) => <li>{tool}</li>)}
							</ul>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section
		id="aviation"
		class="aviation-section section-breakout"
		style={`--aviation-image: url('${aviationBg.src}');`}
		aria-labelledby="aviation-title"
	>
		<div class="aviation-vignette" aria-hidden="true"></div>
		<div class="section-shell aviation-shell">
			<div class="aviation-copy animate-on-scroll">
				<p class="section-index section-index-light"><span>03</span> Beyond the screen</p>
				<h2 id="aviation-title">Precision is a habit.</h2>
				<p>
					Aviation taught me to prepare carefully, communicate clearly, and stay curious when conditions change. Those habits follow me into every product I test and every system I build.
				</p>
			</div>

			<div class="flight-panel animate-on-scroll">
				<div class="flight-panel-top">
					<span>PERSONAL LOG / JH</span>
					<i class="fa-solid fa-plane" aria-hidden="true"></i>
				</div>
				<div class="flight-route" aria-hidden="true">
					<span class="route-point route-start"></span>
					<span class="route-line"></span>
					<i class="fa-solid fa-plane-up route-plane"></i>
					<span class="route-point route-end"></span>
				</div>
				<div class="flight-stats">
					<div><span>Certification</span><strong>Private Pilot</strong></div>
					<div><span>Navigation</span><strong>VFR</strong></div>
					<div><span>Mindset</span><strong>Always learning</strong></div>
				</div>
			</div>
		</div>
	</section>

	<section id="contact" class="site-section contact-section" aria-labelledby="contact-title">
		<div class="section-shell">
			<div class="contact-panel animate-on-scroll">
				<div class="contact-radar" aria-hidden="true"><span></span><span></span><i></i></div>
				<div class="contact-copy">
					<p class="section-index"><span>04</span> Open channel</p>
					<h2 id="contact-title">Let’s build something dependable.</h2>
					<p>
						I’m always interested in thoughtful software, quality engineering, automation, and a good aviation story.
					</p>
				</div>
				<div class="contact-actions">
					<a
						href="https://www.linkedin.com/in/justin-high-4977598b"
						class="button button-primary"
						target="_blank"
						rel="noopener noreferrer"
					>
						<i class="fa-brands fa-linkedin" aria-hidden="true"></i>
						Connect on LinkedIn
					</a>
					<a
						href="https://github.com/novafluxx"
						class="button button-quiet"
						target="_blank"
						rel="noopener noreferrer"
					>
						<i class="fa-brands fa-github" aria-hidden="true"></i>
						Explore GitHub
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script src="../scripts/animations.ts"></script>
<script src="../scripts/smooth-scroll.ts"></script>
<script src="../scripts/hero-3d.ts"></script>
