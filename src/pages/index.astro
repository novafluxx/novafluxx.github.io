---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Justin High - QA Analyst & Automation Engineer">
	<div class="hero-section">
		<div class="hero-content text-center">
			<h1>Justin High</h1>
			<h2>Quality Assurance Analyst & Automation Engineer</h2>
		</div>
	</div>

	<div class="section py-12">
		<div class="container mx-auto px-4">
			<div class="about-grid">
				<div class="glass-card p-8 text-center">
					<i class="fa-solid fa-code text-4xl mb-4 text-blue-500"></i>
					<h3>QA Engineering</h3>
					<p>
						Specialized in developing and implementing comprehensive
						test strategies to ensure software quality and
						reliability.
					</p>
				</div>
				<div class="glass-card p-8 text-center">
					<i class="fa-solid fa-robot text-4xl mb-4 text-purple-500"
					></i>
					<h3>Automation</h3>
					<p>
						Expert in creating efficient automated testing
						frameworks and continuous integration pipelines to speed
						up delivery.
					</p>
				</div>
				<div class="glass-card p-8 text-center">
					<i class="fa-solid fa-plane-up text-4xl mb-4 text-sky-500"
					></i>
					<h3>Aviation</h3>
					<p>
						Licensed private pilot with a passion for aviation and
						aerial photography, bringing a detail-oriented mindset
						to all projects.
					</p>
				</div>
			</div>
		</div>
	</div>

	<div class="section py-12 bg-slate-50 dark:bg-slate-900/50 -mx-8 px-8">
		<div class="container mx-auto px-4">
			<h2
				class="text-3xl font-bold text-center mb-12 text-slate-800 dark:text-white"
			>
				Technical Skills
			</h2>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
				<div class="glass-card p-6 text-center">
					<i class="fa-brands fa-js text-3xl mb-2 text-yellow-400"
					></i>
					<h4 class="font-semibold">JavaScript</h4>
				</div>
				<div class="glass-card p-6 text-center">
					<i class="fa-brands fa-python text-3xl mb-2 text-blue-400"
					></i>
					<h4 class="font-semibold">Python</h4>
				</div>
				<div class="glass-card p-6 text-center">
					<i class="fa-solid fa-vial text-3xl mb-2 text-green-500"
					></i>
					<h4 class="font-semibold">Selenium</h4>
				</div>
				<div class="glass-card p-6 text-center">
					<i
						class="fa-brands fa-git-alt text-3xl mb-2 text-orange-500"
					></i>
					<h4 class="font-semibold">Git</h4>
				</div>
			</div>
		</div>
	</div>
</Layout>
