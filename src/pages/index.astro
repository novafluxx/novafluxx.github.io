---
import Layout from "../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import flightLineImg from "../images/flight-line.jpg";
import forThePeopleImg from "../images/ForThePeople.png";
import fileCrypter2Img from "../images/FileCrypter2_Dotnet.png";
import fileCrypterImg from "../images/FileCrypter_Tauri.png";

const aviationBg = await getImage({
	src: flightLineImg,
	format: "webp",
	quality: 88,
	width: 2048,
	height: 1536,
});

const heroName = "Justin High";

const toolGroups = [
	{
		label: "Test systems",
		tools: ["UI automation", "API testing", "Performance", "Manual testing"],
	},
	{
		label: "Engineering",
		tools: ["JavaScript", "Python", "C# / .NET", "Rust", "SQL"],
	},
	{
		label: "Delivery",
		tools: ["Azure DevOps", "Jira", "Git", "Test planning"],
	},
];

const pageDescription =
	"Justin High — quality engineer and automation builder. QA, automation, and resilient product systems, with the discipline of a private pilot.";
---

<Layout
	title="Justin High | Quality Engineer & Automation Builder"
	description={pageDescription}
>
	<canvas id="constellation-canvas" class="constellation-canvas" aria-hidden="true"></canvas>
	<section id="hero" class="hero-section" aria-labelledby="hero-title">
		<div class="hero-content">
			<div class="hero-layer hero-kicker" style="--depth: 45px;">
				<span class="status-dot" aria-hidden="true"></span>
				Quality systems online
				<span class="kicker-divider" aria-hidden="true"></span>
				Private pilot
			</div>

			<h1
				id="hero-title"
				class="hero-name hero-layer"
				style="--depth: 70px;"
				aria-label={heroName}
			>
				<span class="hero-letters" aria-hidden="true">
					{heroName.split(" ").map((word, wordIndex) => {
						const letterOffset = wordIndex === 0 ? 0 : heroName.indexOf(word);

						return (
							<span class="hero-word">
								{word.split("").map((ch, letterIndex) => (
									<span class="hero-letter" style={`--i: ${letterOffset + letterIndex}`}>{ch}</span>
								))}
							</span>
						);
					})}
				</span>
			</h1>

			<p class="hero-subtitle hero-layer" style="--depth: 38px;">
				Engineering confidence into software.
			</p>
			<p class="hero-intro hero-layer" style="--depth: 28px;">
				Quality assurance, automation, and resilient product engineering, built with the precision of a preflight check.
			</p>

			<div class="hero-actions hero-layer" style="--depth: 22px;">
				<a href="#work" class="button button-primary">
					Explore selected work
					<i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
				</a>
				<a
					href="https://github.com/novafluxx"
					class="button button-quiet"
					target="_blank"
					rel="noopener noreferrer"
				>
					<i class="fa-brands fa-github" aria-hidden="true"></i>
					GitHub
				</a>
			</div>
		</div>

		<a href="#work" class="hero-scroll" aria-label="Scroll to selected work">
			<span>Scroll to inspect</span>
			<span class="scroll-track"><span></span></span>
		</a>
	</section>

	<section id="work" class="site-section work-section" aria-labelledby="work-title">
		<div class="section-shell">
			<header class="section-heading animate-on-scroll">
				<div>
					<p class="section-index"><span>01</span> Selected work</p>
					<h2 id="work-title">Built to survive the edge cases.</h2>
				</div>
				<p class="section-lede">
					I like products where quality is structural, not a final checkbox. These projects combine thoughtful interfaces with dependable systems underneath.
				</p>
			</header>

			<div class="project-grid">
				<article class="project-card project-card-featured project-card-people animate-on-scroll">
					<div class="project-meta">
						<span class="project-number">01 / 04</span>
						<span class="live-chip"><span></span> Live · Civic data</span>
					</div>
					<div class="project-copy">
						<p class="project-type">Near-real-time representation tracker</p>
						<h3>For the People</h3>
						<p class="project-description">
							A live tracker of how many Americans each party represents in Congress—not just how many seats they hold. A tested Python pipeline recomputes membership from official sources every six hours; when the numbers change, the snapshot is committed and a static Astro site rebuilds to Cloudflare. No database and no app state: git is the timeline, and vacant seats stay unassigned instead of being folded into a party total.
						</p>
						<ul class="project-tags" aria-label="For the People technologies">
							<li>Python</li>
							<li>Astro 7</li>
							<li>Cloudflare Workers</li>
						</ul>
						<a
							href="https://forthepeople.wtf"
							class="text-link"
							target="_blank"
							rel="noopener noreferrer"
						>
							Visit live site <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
						</a>
					</div>

					<figure class="people-visual project-shot">
						<Image
							src={forThePeopleImg}
							alt="For the People homepage: Congress does not represent people equally, with a U.S. map and live-data navigation"
							widths={[640, 960, 1280, 1600]}
							sizes="(max-width: 980px) 100vw, 50vw"
							class="project-shot-image"
						/>
					</figure>
				</article>

				<article class="project-card project-card-dotnet animate-on-scroll">
					<div class="project-meta">
						<span class="project-number">02 / 04</span>
						<span class="live-chip"><span></span> Cross-platform · .NET</span>
					</div>
					<figure class="dotnet-visual project-shot">
						<Image
							src={fileCrypter2Img}
							alt="FileCrypter2 Avalonia desktop app: Encrypt a file workflow with drop zone, passphrase panel, and local-only preview"
							widths={[640, 960, 1280]}
							sizes="(max-width: 980px) 100vw, 55vw"
							class="project-shot-image"
						/>
					</figure>
					<div class="project-copy">
						<p class="project-type">Local-first encryption suite</p>
						<h3>FileCrypter2</h3>
						<p class="project-description">
							A .NET rebuild of the same Mac and Windows encryption product: one cryptography core powering a CLI host and an Avalonia desktop UI. Same security goals as the Tauri original—authenticated encryption, Argon2id, optional compression, safely staged writes—on a fully managed stack so I could compare long-term ownership against web + Rust.
						</p>
						<ul class="project-tags" aria-label="FileCrypter2 technologies">
							<li>C# / .NET 10</li>
							<li>Avalonia 12</li>
							<li>AES-256-GCM</li>
							<li>Argon2id</li>
						</ul>
						<a
							href="https://github.com/novafluxx/FileCrypter2"
							class="text-link"
							target="_blank"
							rel="noopener noreferrer"
						>
							View repository <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
						</a>
					</div>
				</article>

				<article class="project-card project-card-featured animate-on-scroll">
					<div class="project-meta">
						<span class="project-number">03 / 04</span>
						<span class="live-chip"><span></span> Cross-platform · Tauri</span>
					</div>
					<div class="project-copy">
						<p class="project-type">Cross-platform security utility</p>
						<h3>FileCrypter</h3>
						<p class="project-description">
							The first pass at that Mac and Windows utility: Vue UI over a Rust/Tauri core. Established the product and threat model—authenticated encryption, memory-hard key derivation, optional compression, crash-safe streaming writes—while evaluating a web-plus-native stack for real cross-platform shipping.
						</p>
						<ul class="project-tags" aria-label="FileCrypter technologies">
							<li>Rust</li>
							<li>Tauri 2</li>
							<li>Vue 3</li>
							<li>AES-256-GCM</li>
						</ul>
						<a
							href="https://github.com/novafluxx/filecrypter"
							class="text-link"
							target="_blank"
							rel="noopener noreferrer"
						>
							View repository <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
						</a>
					</div>

					<figure class="crypto-console project-shot project-shot-tauri">
						<Image
							src={fileCrypterImg}
							alt="FileCrypter Tauri desktop app: Encrypt tab with file pickers, compression option, password, and key file fields"
							widths={[640, 960, 1200]}
							sizes="(max-width: 980px) 100vw, 50vw"
							class="project-shot-image"
						/>
					</figure>
				</article>

				<article class="project-card project-card-notes animate-on-scroll">
					<div class="project-meta">
						<span class="project-number">04 / 04</span>
						<span class="live-chip live-chip-archived"><span></span> Archived</span>
					</div>
					<div class="notes-visual" aria-hidden="true">
						<div class="note-sheet note-sheet-back"></div>
						<div class="note-sheet note-sheet-middle"></div>
						<div class="note-sheet note-sheet-front">
							<span class="note-dot"></span>
							<span class="note-line note-line-title"></span>
							<span class="note-line"></span>
							<span class="note-line note-line-short"></span>
							<span class="sync-pill sync-pill-archived"><i class="fa-solid fa-box-archive"></i> archived</span>
						</div>
					</div>
					<p class="project-type">Offline-first progressive web app</p>
					<h3>High Notes</h3>
					<p class="project-description">
						A fast note-taking PWA with rich-text editing, local caching, queued offline mutations, secure cloud sync, and realtime updates across devices. The live app is shut down; the code remains archived on GitHub.
					</p>
					<ul class="project-tags" aria-label="High Notes technologies">
						<li>Nuxt 4</li>
						<li>TypeScript</li>
						<li>Supabase</li>
						<li>IndexedDB</li>
					</ul>
					<a
						href="https://github.com/novafluxx/HighNotes"
						class="text-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						View archive <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
					</a>
				</article>
			</div>

			<div class="proof-strip animate-on-scroll" aria-label="Engineering principles">
				<div><span>01</span><strong>Security-minded</strong><small>Threats considered early</small></div>
				<div><span>02</span><strong>Cross-platform</strong><small>Desktop and web systems</small></div>
				<div><span>03</span><strong>Offline-ready</strong><small>Resilient when networks fail</small></div>
				<div><span>04</span><strong>Suite-maintained</strong><small>Coverage kept current as products change</small></div>
			</div>
		</div>
	</section>

	<section id="experience" class="site-section experience-section" aria-labelledby="experience-title">
		<div class="section-shell">
			<header class="section-heading section-heading-compact animate-on-scroll">
				<div>
					<p class="section-index"><span>02</span> Quality practice</p>
					<h2 id="experience-title">Turn risk into signal.</h2>
				</div>
			</header>

			<div class="experience-layout">
				<div class="experience-narrative animate-on-scroll">
					<p class="experience-role">Quality Assurance Analyst & Automation Engineer</p>
					<p class="experience-domain">Healthcare · Release of Information</p>
					<h3>Quality should make teams move faster, not make them afraid to ship.</h3>
					<p>
						In healthcare Release of Information (ROI), I work quality into the core ROI web application and a FHIR-compliant API built for faster information requests and document delivery. I established the API test suite so contract and behavior stay trustworthy as the integration evolves, and I help maintain a broad automation suite over the main web product—updating coverage when the app changes so regressions surface early in delivery.
					</p>
					<ul class="experience-highlights" aria-label="Current focus areas">
						<li>
							<strong>FHIR ROI API</strong>
							<span>Built and run automated checks for a FHIR-compliant API that handles ROI requests and document delivery.</span>
						</li>
						<li>
							<strong>ROI web automation</strong>
							<span>Help maintain and extend a suite covering the main application’s critical workflows as the product changes.</span>
						</li>
					</ul>
					<div class="practice-flow" aria-label="Quality engineering workflow">
						<div><span>01</span><strong>Observe</strong><small>Map behavior and risk</small></div>
						<div><span>02</span><strong>Automate</strong><small>Cover critical paths</small></div>
						<div><span>03</span><strong>Validate</strong><small>Prove API and UI behavior</small></div>
						<div><span>04</span><strong>Maintain</strong><small>Keep suites current as the product changes</small></div>
					</div>
				</div>

				<div class="quality-console animate-on-scroll" aria-label="Quality system status">
					<div class="quality-console-header">
						<div>
							<span class="status-dot" aria-hidden="true"></span>
							Quality signal
						</div>
						<span>LIVE</span>
					</div>
					<div class="signal-orbit" aria-hidden="true">
						<span class="orbit orbit-a"></span>
						<span class="orbit orbit-b"></span>
						<span class="orbit orbit-c"></span>
						<div class="signal-center"><i class="fa-solid fa-wave-square"></i></div>
						<span class="signal-node node-ui">UI</span>
						<span class="signal-node node-api">API</span>
						<span class="signal-node node-perf">FHIR</span>
						<span class="signal-node node-ci">SUITE</span>
					</div>
					<div class="signal-list">
						<div><span><i></i> Critical paths</span><strong>MONITORED</strong></div>
						<div><span><i></i> API contracts</span><strong>CHECKED</strong></div>
						<div><span><i></i> Suite health</span><strong>MAINTAINED</strong></div>
					</div>
				</div>
			</div>

			<div class="toolkit animate-on-scroll">
				<div class="toolkit-intro">
					<p class="section-index"><span>STACK</span> Working toolkit</p>
					<p>Practical tools chosen for the system in front of me, not for the résumé keyword count.</p>
				</div>
				<div class="tool-groups">
					{toolGroups.map((group) => (
						<div class="tool-group">
							<h3>{group.label}</h3>
							<ul>
								{group.tools.map((tool) => <li>{tool}</li>)}
							</ul>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section
		id="aviation"
		class="aviation-section section-breakout"
		style={`--aviation-image: url('${aviationBg.src}');`}
		aria-labelledby="aviation-title"
	>
		<div class="aviation-vignette" aria-hidden="true"></div>
		<div class="section-shell aviation-shell">
			<div class="aviation-copy animate-on-scroll">
				<p class="section-index section-index-light"><span>03</span> Beyond the screen</p>
				<h2 id="aviation-title">Precision is a habit.</h2>
				<p>
					Aviation taught me to prepare carefully, communicate clearly, and stay curious when conditions change. Those habits follow me into every product I test and every system I build.
				</p>
			</div>

			<div class="flight-panel animate-on-scroll">
				<div class="flight-panel-top">
					<span>PERSONAL LOG / JH</span>
					<i class="fa-solid fa-plane" aria-hidden="true"></i>
				</div>
				<div class="flight-route" aria-hidden="true">
					<span class="route-point route-start"></span>
					<span class="route-line"></span>
					<i class="fa-solid fa-plane-up route-plane"></i>
					<span class="route-point route-end"></span>
				</div>
				<div class="flight-stats">
					<div><span>Certification</span><strong>Private Pilot</strong></div>
					<div><span>Navigation</span><strong>VFR</strong></div>
					<div><span>Mindset</span><strong>Always learning</strong></div>
				</div>
			</div>
		</div>
	</section>

	<section id="contact" class="site-section contact-section" aria-labelledby="contact-title">
		<div class="section-shell">
			<div class="contact-panel animate-on-scroll">
				<div class="contact-radar" aria-hidden="true"><span></span><span></span><i></i></div>
				<div class="contact-copy">
					<p class="section-index"><span>04</span> Open channel</p>
					<h2 id="contact-title">Let’s build something dependable.</h2>
					<p>
						I’m always interested in thoughtful software, quality engineering, automation, and a good aviation story.
					</p>
				</div>
				<div class="contact-actions">
					<a
						href="https://www.linkedin.com/in/justin-h-4977598b/"
						class="button button-primary"
						target="_blank"
						rel="noopener noreferrer"
					>
						<i class="fa-brands fa-linkedin" aria-hidden="true"></i>
						Connect on LinkedIn
					</a>
					<a
						href="https://github.com/novafluxx"
						class="button button-quiet"
						target="_blank"
						rel="noopener noreferrer"
					>
						<i class="fa-brands fa-github" aria-hidden="true"></i>
						Explore GitHub
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script src="../scripts/animations.ts"></script>
<script src="../scripts/smooth-scroll.ts"></script>
<script src="../scripts/constellation.ts"></script>
