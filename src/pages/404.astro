---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found">
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
    <h1 class="text-6xl md:text-8xl font-bold mb-4 text-slate-800 dark:text-white">
      404
    </h1>
    <h2 class="text-2xl md:text-3xl font-semibold mb-4 text-slate-700 dark:text-slate-200">
      Page Not Found
    </h2>
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8 max-w-md">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-200"
    >
      <i class="fas fa-home"></i>
      <span>Back to Home</span>
    </a>
  </div>
</Layout>
