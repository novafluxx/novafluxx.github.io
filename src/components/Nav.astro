---
const links = [
    { href: "/", label: "Home", icon: "fas fa-home" },
    { href: "/experience", label: "Experience", icon: "fas fa-briefcase" },
    { href: "/aviation", label: "Aviation", icon: "fas fa-plane" },
    { href: "/contact", label: "Contact", icon: "fas fa-envelope" },
];

const { currentPath = Astro.url.pathname } = Astro.props;
---

<nav
    class="flex justify-center items-center h-full w-full max-w-[1200px] mx-auto px-4"
>
    <div
        class="flex justify-center items-center gap-4 sm:gap-6 md:gap-10 relative z-101 bg-white/10 backdrop-blur-md px-4 sm:px-8 py-2 rounded-full border border-white/20 shadow-lg mt-8"
    >
        {
            links.map((link) => (
                <a
                    href={link.href}
                    class={`group flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 font-medium no-underline transition-all duration-300 text-xs sm:text-base md:text-base hover:scale-105 focus:scale-105 ${
                        currentPath === link.href
                            ? "text-white font-bold drop-shadow-md"
                            : "text-slate-200 hover:text-white"
                    }`}
                    aria-current={currentPath === link.href ? "page" : undefined}
                    aria-label={link.label}
                >
                    <span class="inline-flex items-center justify-center leading-none">
                        <i
                            class={`${link.icon} transition-colors duration-300 ${currentPath === link.href ? "text-sky-300" : "text-slate-300 group-hover:text-white"} !mb-0 text-xl`}
                        />
                    </span>
                    <span class="sm:inline leading-none">{link.label}</span>
                </a>
            ))
        }
    </div>
</nav>
