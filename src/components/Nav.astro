---
const links = [
    { href: "#hero", label: "Home", icon: "fas fa-home" },
    { href: "#work", label: "Work", icon: "fas fa-code-branch" },
    { href: "#experience", label: "Experience", icon: "fas fa-briefcase" },
    { href: "#aviation", label: "Aviation", icon: "fas fa-plane" },
    { href: "#contact", label: "Contact", icon: "fas fa-envelope" },
];
---

<nav
    class="site-nav flex justify-center items-center h-full w-full max-w-300 mx-auto px-4"
>
    <div
        class="nav-shell flex justify-center items-center relative z-101 mt-8"
    >
        {
            links.map((link) => (
                <a
                    href={link.href}
                    class={`nav-link group flex items-center justify-center font-medium no-underline transition-all duration-300 ${link.href === "#hero" ? "active" : ""}`}
                    aria-label={link.label}
                >
                    <span class="nav-icon inline-flex items-center justify-center leading-none">
                        <i
                            class={`${link.icon} transition-colors duration-300 mb-0!`}
                        />
                    </span>
                    <span class="nav-label inline leading-none">{link.label}</span>
                </a>
            ))
        }
        <button
            id="theme-toggle"
            type="button"
            class="theme-toggle group flex items-center justify-center font-medium transition-all duration-300"
            aria-label="Switch to light mode"
            aria-pressed="true"
        >
            <span class="nav-icon inline-flex items-center justify-center leading-none">
                <i
                    id="theme-icon"
                    class="fas fa-sun transition-colors duration-300 mb-0!"
                />
            </span>
        </button>
    </div>
</nav>

<script src="../scripts/nav.ts"></script>
