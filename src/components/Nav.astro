---
const links = [
    { href: "#hero", label: "Home", icon: "fas fa-home" },
    { href: "#about", label: "About", icon: "fas fa-user" },
    { href: "#experience", label: "Experience", icon: "fas fa-briefcase" },
    { href: "#aviation", label: "Aviation", icon: "fas fa-plane" },
    { href: "#contact", label: "Contact", icon: "fas fa-envelope" },
];
---

<nav
    class="flex justify-center items-center h-full w-full max-w-[1200px] mx-auto px-4"
>
    <div
        class="flex justify-center items-center gap-1.5 sm:gap-2.5 md:gap-4 lg:gap-6 relative z-101 bg-slate-900/10 dark:bg-white/10 backdrop-blur-md px-2 sm:px-2.5 md:px-4 lg:px-6 py-2 rounded-full border border-slate-900/20 dark:border-white/20 shadow-lg mt-8"
    >
        {
            links.map((link) => (
                <a
                    href={link.href}
                    class="nav-link group flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 font-medium no-underline transition-all duration-300 text-xs sm:text-sm md:text-base text-slate-700 hover:text-slate-900 dark:text-slate-200 dark:hover:text-white"
                    aria-label={link.label}
                >
                    <span class="inline-flex items-center justify-center leading-none">
                        <i
                            class={`${link.icon} transition-colors duration-300 text-slate-500 group-hover:text-slate-700 dark:text-slate-300 dark:group-hover:text-white mb-0! text-sm sm:text-base md:text-lg`}
                        />
                    </span>
                    <span class="inline leading-none">{link.label}</span>
                </a>
            ))
        }
        <button
            id="theme-toggle"
            type="button"
            class="group flex items-center justify-center font-medium transition-all duration-300 text-slate-700 hover:text-slate-900 dark:text-slate-200 dark:hover:text-white"
            aria-label="Toggle theme"
        >
            <span class="inline-flex items-center justify-center leading-none">
                <i
                    id="theme-icon"
                    class="fas fa-sun transition-colors duration-300 text-slate-500 group-hover:text-slate-700 dark:text-slate-300 dark:group-hover:text-white mb-0! text-sm sm:text-base md:text-lg"
                />
            </span>
        </button>
    </div>
</nav>

<script>
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const html = document.documentElement;

    // Check for saved theme preference or default to 'dark'
    const currentTheme = localStorage.getItem('theme') || 'dark';

    // Apply the theme on page load
    if (currentTheme === 'light') {
        html.classList.remove('dark');
    } else {
        html.classList.add('dark');
    }

    // Update icon based on current theme
    function updateIcon() {
        if (html.classList.contains('dark')) {
            // Dark mode: show sun (click to go light)
            themeIcon?.classList.remove('fa-moon');
            themeIcon?.classList.add('fa-sun');
        } else {
            // Light mode: show moon (click to go dark)
            themeIcon?.classList.remove('fa-sun');
            themeIcon?.classList.add('fa-moon');
        }
    }

    // Set initial icon
    updateIcon();

    // Toggle theme on button click
    themeToggle?.addEventListener('click', () => {
        html.classList.toggle('dark');

        // Save preference to localStorage
        const newTheme = html.classList.contains('dark') ? 'dark' : 'light';
        localStorage.setItem('theme', newTheme);

        // Update icon
        updateIcon();
    });

    // Active Section Detection
    function initActiveSection() {
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.nav-link');

        if (!sections.length || !navLinks.length) return;

        const observerOptions = {
            root: null,
            rootMargin: '-20% 0px -80% 0px',
            threshold: 0,
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const id = entry.target.getAttribute('id');

                    navLinks.forEach((link) => {
                        link.classList.remove('active');
                        if (link.getAttribute('href') === `#${id}`) {
                            link.classList.add('active');
                        }
                    });
                }
            });
        }, observerOptions);

        sections.forEach((section) => observer.observe(section));
    }

    // Initialize active section detection
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initActiveSection);
    } else {
        initActiveSection();
    }

    // Adaptive Navigation - Change colors based on background section
    function initAdaptiveNav() {
        const nav = document.querySelector('nav');
        const darkSections = ['aviation']; // Sections with dark backgrounds (hero follows theme, not always dark)

        if (!nav) return;

        function updateNavStyle() {
            if (!nav) return;

            const navRect = nav.getBoundingClientRect();
            const navCenter = navRect.top + navRect.height / 2;

            // Find which section the nav center is over
            const sections = document.querySelectorAll('section[id]');
            let isOverDarkSection = false;

            sections.forEach((section) => {
                const sectionRect = section.getBoundingClientRect();
                if (
                    navCenter >= sectionRect.top &&
                    navCenter <= sectionRect.bottom
                ) {
                    const sectionId = section.getAttribute('id');
                    if (sectionId && darkSections.includes(sectionId)) {
                        isOverDarkSection = true;
                    }
                }
            });

            // Apply appropriate styling
            if (isOverDarkSection) {
                nav.classList.add('nav-over-dark');
                nav.classList.remove('nav-over-light');
            } else {
                nav.classList.add('nav-over-light');
                nav.classList.remove('nav-over-dark');
            }
        }

        // Update on scroll
        window.addEventListener('scroll', updateNavStyle);
        // Initial update
        updateNavStyle();
    }

    // Initialize adaptive nav
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAdaptiveNav);
    } else {
        initAdaptiveNav();
    }
</script>
