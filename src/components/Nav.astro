---
const links = [
    { href: "/", label: "Home", icon: "fas fa-home" },
    { href: "/experience", label: "Experience", icon: "fas fa-briefcase" },
    { href: "/aviation", label: "Aviation", icon: "fas fa-plane" },
    { href: "/contact", label: "Contact", icon: "fas fa-envelope" },
];

const { currentPath = Astro.url.pathname } = Astro.props;
---

<nav
    class="flex justify-center items-center h-full w-full max-w-[1200px] mx-auto px-4"
>
    <div
        class="flex justify-center items-center gap-4 sm:gap-6 md:gap-10 relative z-101 bg-slate-900/10 dark:bg-white/10 backdrop-blur-md px-4 sm:px-8 py-2 rounded-full border border-slate-900/20 dark:border-white/20 shadow-lg mt-8"
    >
        {
            links.map((link) => (
                <a
                    href={link.href}
                    class={`group flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 font-medium no-underline transition-all duration-300 text-xs sm:text-base md:text-base hover:scale-105 focus:scale-105 ${
                        currentPath === link.href
                            ? "text-slate-900 dark:text-white font-bold drop-shadow-md"
                            : "text-slate-700 hover:text-slate-900 dark:text-slate-200 dark:hover:text-white"
                    }`}
                    aria-current={currentPath === link.href ? "page" : undefined}
                    aria-label={link.label}
                >
                    <span class="inline-flex items-center justify-center leading-none">
                        <i
                            class={`${link.icon} transition-colors duration-300 ${currentPath === link.href ? "text-blue-500 dark:text-sky-300" : "text-slate-500 group-hover:text-slate-700 dark:text-slate-300 dark:group-hover:text-white"} mb-0! text-xl`}
                        />
                    </span>
                    <span class="sm:inline leading-none">{link.label}</span>
                </a>
            ))
        }
        <button
            id="theme-toggle"
            type="button"
            class="group flex items-center justify-center font-medium transition-all duration-300 text-slate-700 hover:text-slate-900 dark:text-slate-200 dark:hover:text-white hover:scale-105 focus:scale-105"
            aria-label="Toggle theme"
        >
            <span class="inline-flex items-center justify-center leading-none">
                <i
                    id="theme-icon"
                    class="fas fa-sun transition-colors duration-300 text-slate-500 group-hover:text-slate-700 dark:text-slate-300 dark:group-hover:text-white mb-0! text-xl"
                />
            </span>
        </button>
    </div>
</nav>

<script>
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const html = document.documentElement;

    // Check for saved theme preference or default to 'dark'
    const currentTheme = localStorage.getItem('theme') || 'dark';

    // Apply the theme on page load
    if (currentTheme === 'light') {
        html.classList.remove('dark');
    } else {
        html.classList.add('dark');
    }

    // Update icon based on current theme
    function updateIcon() {
        if (html.classList.contains('dark')) {
            // Dark mode: show sun (click to go light)
            themeIcon?.classList.remove('fa-moon');
            themeIcon?.classList.add('fa-sun');
        } else {
            // Light mode: show moon (click to go dark)
            themeIcon?.classList.remove('fa-sun');
            themeIcon?.classList.add('fa-moon');
        }
    }

    // Set initial icon
    updateIcon();

    // Toggle theme on button click
    themeToggle?.addEventListener('click', () => {
        html.classList.toggle('dark');

        // Save preference to localStorage
        const newTheme = html.classList.contains('dark') ? 'dark' : 'light';
        localStorage.setItem('theme', newTheme);

        // Update icon
        updateIcon();
    });
</script>
